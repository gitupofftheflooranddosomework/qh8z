QH8Z_DOMAIN=qh8z.com
NODE_ENV=production
APP_BASE_URL=https://qh8z.com
PUBLIC_SHORT_BASE_URL=https://qh8z.com
SHLINK_HTTPS_ENABLED=true
COOKIE_SECURE=true
ALLOW_SIGNUP=true
SESSION_TTL_DAYS=30

POSTGRES_PASSWORD=replace-with-openssl-rand-hex-32
SHLINK_API_KEY=replace-with-a-different-openssl-rand-hex-32
ADMIN_EMAIL=admin@example.com
ADMIN_BOOTSTRAP_SECRET=replace-with-a-third-openssl-rand-hex-32
SUPPORT_EMAIL=support@qh8z.com

# Required for production link creation.
WEB_RISK_API_KEY=
WEB_RISK_REQUIRED=true

GEOLITE_LICENSE_KEY=
SKIP_INITIAL_GEOLITE_DOWNLOAD=true

# Optional until paid plans are enabled.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRO_PRICE_ID=

APP_DEV_PORT=3000
SHLINK_DEV_PORT=8080
