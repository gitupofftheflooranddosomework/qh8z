QH8Z_DOMAIN=qh8z.com
NODE_ENV=production
APP_BASE_URL=https://qh8z.com
PUBLIC_SHORT_BASE_URL=https://qh8z.com
SHLINK_HTTPS_ENABLED=true
COOKIE_SECURE=true
ALLOW_SIGNUP=true
PUBLIC_LAUNCH_MODE=true
EMAIL_VERIFICATION_REQUIRED=true
TERMS_VERSION=2026-08-17
DEV_EXPOSE_AUTH_TOKENS=false
SESSION_TTL_DAYS=30
DATA_RETENTION_DAYS=365
REPUTATION_RECHECK_HOURS=24
REPUTATION_RECHECK_BATCH=25
REPUTATION_WORKER_MINUTES=15

POSTGRES_PASSWORD=replace-with-openssl-rand-hex-32
SHLINK_API_KEY=replace-with-a-different-openssl-rand-hex-32
ADMIN_EMAIL=replace-with-real-admin-email
MFA_ENCRYPTION_KEY=replace-with-fourth-openssl-rand-hex-32
# Required only until the first admin account is bootstrapped; rotate/remove afterward.
ADMIN_BOOTSTRAP_SECRET=replace-with-a-third-openssl-rand-hex-32
SUPPORT_EMAIL=support@qh8z.com
ABUSE_EMAIL=abuse@qh8z.com
LEGAL_OPERATOR_NAME=replace-with-legal-person-or-company-name
LEGAL_JURISDICTION=replace-with-governing-jurisdiction

# Required for PUBLIC_LAUNCH_MODE.
WEB_RISK_API_KEY=replace-with-google-web-risk-key
WEB_RISK_REQUIRED=true
TURNSTILE_SITE_KEY=replace-with-cloudflare-turnstile-site-key
TURNSTILE_SECRET_KEY=replace-with-cloudflare-turnstile-secret-key
TURNSTILE_REQUIRED=true

# Required for verified public signup and password recovery.
MAIL_MODE=smtp
MAIL_FROM="QH8Z <support@qh8z.com>"
SMTP_HOST=replace-with-smtp-host
SMTP_PORT=587
SMTP_SECURE=false
SMTP_REQUIRE_TLS=true
SMTP_USER=replace-me
SMTP_PASS=replace-me

GEOLITE_LICENSE_KEY=
SKIP_INITIAL_GEOLITE_DOWNLOAD=true

# Optional until paid plans are enabled. Configure all three together.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRO_PRICE_ID=

APP_DEV_PORT=3000
SHLINK_DEV_PORT=8080
