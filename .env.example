# Core domain/runtime
QH8Z_DOMAIN=qh8z.com
NODE_ENV=development
APP_BASE_URL=http://localhost:3000
PUBLIC_SHORT_BASE_URL=http://localhost:8080
SHLINK_HTTPS_ENABLED=false
COOKIE_SECURE=false
ALLOW_SIGNUP=true
SESSION_TTL_DAYS=30

# Generate both secrets before first boot, for example:
#   openssl rand -hex 32
POSTGRES_PASSWORD=change-me-to-a-long-random-secret
SHLINK_API_KEY=change-me-to-a-long-random-secret

# The admin email is reserved; admin creation additionally requires this bootstrap secret.
ADMIN_EMAIL=
ADMIN_BOOTSTRAP_SECRET=change-me-to-another-long-random-secret
SUPPORT_EMAIL=support@qh8z.com

# Destination safety. Set true with a real key before production launch.
WEB_RISK_API_KEY=
WEB_RISK_REQUIRED=false

# Optional: Shlink visit geolocation. Leave blank to run without geolocation.
GEOLITE_LICENSE_KEY=
SKIP_INITIAL_GEOLITE_DOWNLOAD=true

# Optional Stripe monetization. Billing UI stays disabled when these are blank.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRO_PRICE_ID=

APP_DEV_PORT=3000
SHLINK_DEV_PORT=8080
