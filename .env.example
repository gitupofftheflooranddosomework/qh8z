# QH8Z local development
QH8Z_ADMIN_TOKEN=change-me-to-a-long-random-secret
SHLINK_API_KEY=replace-after-generating-a-shlink-api-key

# Shlink
SHLINK_DEFAULT_DOMAIN=localhost:8080
