# Public service
QH8Z_DOMAIN=qh8z.com
ACME_EMAIL=admin@qh8z.com

# SMTP (credentials are secret files)
SMTP_ADDR=smtp.example.com:587
SMTP_HOST=smtp.example.com
SMTP_USERNAME=apikey
SMTP_FROM=qh8z <noreply@qh8z.com>

# Google Web Risk
WEBRISK_EXTENDED_COVERAGE=false

# Stripe (secret key and webhook signing secret are secret files)
STRIPE_PRO_PRICE_ID=price_replace_me

# Encrypted offsite backup repository, for example:
# s3:https://s3.ca-central-1.amazonaws.com/qh8z-production-backups
RESTIC_REPOSITORY=s3:https://object-storage.example.com/qh8z-production-backups
BACKUP_INTERVAL_SECONDS=21600

# Directory and group for file-mounted secrets. deploy/init-secrets.sh normalizes
# the directory to root:<gid> mode 0750 and files to root:<gid> mode 0640.
QH8Z_SECRETS_DIR=/etc/qh8z/secrets
QH8Z_SECRET_GID=65532
