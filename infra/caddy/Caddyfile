www.{$QH8Z_DOMAIN} {
  redir https://{$QH8Z_DOMAIN}{uri} permanent
}

{$QH8Z_DOMAIN} {
  encode zstd gzip

  header {
    Strict-Transport-Security "max-age=31536000; includeSubDomains"
    X-Content-Type-Options "nosniff"
    Referrer-Policy "strict-origin-when-cross-origin"
  }

  @product {
    path / /app /app/* /login /signup /privacy /terms /report /healthz /favicon.svg /robots.txt /api/* /assets/*
  }

  handle @product {
    reverse_proxy app:3000
  }

  handle {
    reverse_proxy shlink:8080
  }
}
